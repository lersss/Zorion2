{
	admin off
}

# Игра отдаётся по домену skylab.ru. Caddy сам выпускает и продлевает
# HTTPS-сертификат Let's Encrypt. Порты 80/443 держит контейнер caddy —
# веб-сервер хостинг-панели (nginx.service) на сервере отключён, иначе он
# перехватывает порты и показывает заглушку.
skylab.ru {
	reverse_proxy app:8080
}
