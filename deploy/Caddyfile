{
	admin off
}

# Пока домен/нейм-серверы не подняты — игра доступна по IP сервера (порт 80,
# обычный HTTP). После настройки DNS добавить блок с доменом, например:
#   skylab.ru {
#       reverse_proxy app:8080
#   }
# Caddy сам выпустит и продлит HTTPS-сертификат Let's Encrypt.
:80 {
	reverse_proxy app:8080
}
